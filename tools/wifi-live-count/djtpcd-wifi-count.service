[Unit]
Description=DJ The PC Dude live Wi-Fi/LAN device count collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/djtpcd-wifi-count.env
WorkingDirectory=/opt/djtpcd-wifi-count
ExecStart=/usr/bin/python3 /opt/djtpcd-wifi-count/collector.py
Restart=always
RestartSec=10
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
